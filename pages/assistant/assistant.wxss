.assistant-page{height:100vh;background:#f3f6f2;display:flex;flex-direction:column;box-sizing:border-box}.assistant-head{display:flex;align-items:center;gap:18rpx;background:#fff;padding:24rpx 30rpx;border-bottom:1rpx solid #e6ece7}.ai-orb{width:72rpx;height:72rpx;border-radius:50%;background:#255e4f;color:#fff;display:flex;align-items:center;justify-content:center;font-size:34rpx}.assistant-name,.assistant-status{display:block}.assistant-name{font-weight:800;font-size:31rpx}.assistant-status{font-size:20rpx;color:#70a47e;margin-top:5rpx}.chat{flex:1;padding:26rpx;box-sizing:border-box;overflow:hidden}.message-row{display:flex;margin-bottom:22rpx}.message-row.user{justify-content:flex-end}.bubble{max-width:76%;background:#fff;border-radius:8rpx 24rpx 24rpx 24rpx;padding:20rpx 24rpx;font-size:27rpx;line-height:1.65;box-shadow:0 6rpx 20rpx rgba(41,76,58,.06)}.user .bubble{background:#255e4f;color:#fff;border-radius:24rpx 8rpx 24rpx 24rpx}.error .bubble{background:#fff0ed;color:#b75048}.typing{color:#788a82}.quick-list{white-space:nowrap;padding:10rpx 20rpx;box-sizing:border-box}.quick-inner{display:inline-flex;gap:12rpx}.quick-inner button{background:#fff;border:1rpx solid #cddbd1;border-radius:30rpx;color:#527264;font-size:22rpx;padding:8rpx 18rpx}.quick-inner button::after{border:0}.composer{display:flex;align-items:flex-end;gap:14rpx;background:#fff;padding:18rpx 24rpx}.composer textarea{flex:1;min-height:48rpx;max-height:180rpx;background:#f3f6f2;border-radius:18rpx;padding:17rpx 20rpx;font-size:26rpx}.composer button{margin:0;background:#255e4f;color:#fff;border-radius:16rpx;font-size:24rpx;padding:15rpx 22rpx}.ai-notice{background:#fff;color:#98a49f;text-align:center;font-size:18rpx;padding:0 0 18rpx}
