<view class="page"><view wx:if="{{loading}}" class="empty">正在加载...</view><view wx:elif="{{loginError}}" class="empty">{{loginError}}</view><block wx:else><view class="profile-head"><image wx:if="{{user.avatarUrl}}" class="avatar" src="{{user.avatarUrl}}" mode="aspectFill"></image><view wx:elif="{{user.avatarEmoji}}" class="avatar random-avatar" style="background:{{user.avatarColor}}">{{user.avatarEmoji}}</view><view wx:else class="avatar">{{avatarText}}</view><view><text class="eyebrow">我的学习档案</text><text class="title" style="font-size:42rpx;margin:5rpx 0">{{user.realName||'未设置名称'}}</text><text class="muted">{{isGuest?'游客':(user.identityType==='random'?'随机身份':'学生')}}</text></view></view><view wx:if="{{isGuest}}" class="guest-card card"><text class="section-title">登录后解锁完整功能</text><button class="primary" bindtap="onGoLogin">立即登录</button></view><block wx:else><button class="outline" bindtap="editProfile">修改名称或头像</button><view class="card points" style="margin-top:24rpx"><view><text class="eyebrow">我的积分</text><text class="points-num">{{user.points||0}}</text></view><button class="primary" bindtap="onRedeem">兑换礼物</button></view><button class="logout-button" bindtap="onLogout">退出登录</button></block></block></view>
