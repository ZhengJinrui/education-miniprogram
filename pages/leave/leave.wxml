<view class="page"><text class="eyebrow">LEAVE REQUEST</text><text class="title">提交请假申请</text><view class="card"><text class="muted">请假课程</text><text style="display:block;margin:14rpx 0 28rpx;font-size:30rpx;font-weight:700">{{course}}</text><text class="muted">请假日期</text><picker mode="date" bindchange="onDate"><view class="input">{{date||'请选择日期'}}</view></picker><text class="muted">请假原因</text><textarea class="input" placeholder="请填写请假原因" bindinput="onReason" maxlength="120"></textarea><button class="primary" style="width:100%" bindtap="onSubmit">提交给任课老师</button></view></view>
