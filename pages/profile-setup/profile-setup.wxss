.setup-page{min-height:100vh;background:#e8f1e8;padding:70rpx 42rpx;box-sizing:border-box}.setup-head{text-align:center}.setup-title{display:block;font-size:52rpx;font-weight:800;margin:15rpx 0}.setup-card{background:#fff;border-radius:32rpx;padding:48rpx 38rpx;margin-top:55rpx;box-shadow:0 20rpx 70rpx rgba(37,94,79,.1)}.avatar-picker{width:190rpx;height:190rpx;border-radius:50%;padding:0;margin:0 auto 22rpx;background:#eef5ef;overflow:hidden;border:3rpx dashed #a8c2b1}.avatar-picker image{width:100%;height:100%}.avatar-placeholder{height:100%;display:flex;flex-direction:column;align-items:center;justify-content:center;color:#6f8b7c}.avatar-actions{display:flex;justify-content:center;gap:16rpx;margin-bottom:40rpx}.avatar-actions button{margin:0}.avatar-actions .danger{color:#c94f46;border-color:#e8c8c5}.field-label{display:block;font-size:24rpx;color:#70817b;margin-bottom:12rpx}.field-hint{display:block;font-size:20rpx;color:#87968f;margin-top:12rpx}.nickname-input{background:#f7f9f5;border:1rpx solid #e1e9e3;border-radius:14rpx;padding:22rpx;font-size:28rpx}.save-button{margin-top:38rpx;background:#255e4f!important;color:#fff!important;border-radius:15rpx;font-weight:700}
