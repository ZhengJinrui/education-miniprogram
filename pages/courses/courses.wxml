<view class="page"><text class="eyebrow">课程中心</text><text class="title">找到适合你的那一课</text><input class="input" placeholder="搜索课程或老师" bindinput="onSearch"/><view class="course-list"><block wx:for="{{filtered}}" wx:key="name"><view class="course-card" bindtap="onTap" data-name="{{item.name}}"><view class="course-cover" style="background:{{item.color}}"><text>{{item.mark}}</text></view><view class="course-body"><text class="course-name">{{item.name}}</text><text class="muted">{{item.teacher}} · 金牌讲师</text><view class="row price-row"><text class="price">{{item.price}}</text><text class="link">查看详情 →</text></view></view></view></block><view wx:if="{{!filtered.length}}" class="empty">没有找到相关课程或老师</view></view></view>
