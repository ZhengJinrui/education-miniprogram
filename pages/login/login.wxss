.login-page{min-height:100vh;background:#e8f1e8;position:relative;overflow:hidden;padding:150rpx 48rpx 60rpx;box-sizing:border-box}.login-decor{position:absolute;border-radius:50%}.decor-one{width:420rpx;height:420rpx;background:#f1c583;right:-160rpx;top:-120rpx}.decor-two{width:360rpx;height:360rpx;background:#a5c7b4;left:-190rpx;bottom:100rpx}.login-brand{position:relative;z-index:1;text-align:center}.login-logo{width:112rpx;height:112rpx;border-radius:32rpx;background:#255e4f;color:#fff;margin:0 auto 22rpx;display:flex;align-items:center;justify-content:center;font-size:58rpx;font-weight:800}.login-brand>text{display:block;font-size:42rpx;font-weight:800}.login-brand .login-slogan{font-size:22rpx;color:#70817b;font-weight:400;letter-spacing:3rpx;margin-top:10rpx}.login-panel{position:relative;z-index:2;background:#fff;border-radius:34rpx;padding:46rpx 38rpx;margin-top:80rpx;box-shadow:0 24rpx 80rpx rgba(37,94,79,.12)}.login-title{display:block;font-size:43rpx;font-weight:800;line-height:1.3;margin:14rpx 0 20rpx}.agreement-row{display:flex;align-items:center;justify-content:center;flex-wrap:wrap;margin-top:34rpx;color:#87968f;font-size:21rpx;line-height:1.8}.agreement-check{display:flex;align-items:center}.agreement-link{color:#255e4f;font-weight:600}.avatar-choice{margin-top:24rpx;text-align:center;color:#70817b;font-size:21rpx}.avatar-choice label{display:flex;justify-content:center;align-items:center}.wechat-login{margin-top:24rpx;background:#255e4f!important;color:#fff!important;border-radius:16rpx;font-size:29rpx;font-weight:700;padding:10rpx}.guest-login{margin-top:14rpx;background:transparent!important;color:#70817b!important;font-size:24rpx}.login-error{display:block;color:#cf5d55;font-size:22rpx;text-align:center;margin-top:18rpx;line-height:1.5}
